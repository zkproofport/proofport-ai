{
  "name": "@zkproofport-ai/sdk",
  "version": "0.5.0",
  "description": "TypeScript SDK for ZKProofport Coinbase KYC, country, OIDC and GIWA attestation proofs. Optional EIP-712 action binding for GIWA; x402 USDC payments.",
  "keywords": [
    "sdk",
    "typescript",
    "zero-knowledge-proofs",
    "zk-proofs",
    "zkp",
    "ai-agents",
    "privacy",
    "identity",
    "coinbase-kyc",
    "google-oidc",
    "x402",
    "erc-8004",
    "noir-lang",
    "base-chain",
    "ethers",
    "action-authorization",
    "eip-712"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@zkproofport-app/core": "0.4.0-beta.0",
    "ethers": "^6.13.0",
    "viem": "^2.45.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkproofport/proofport-ai",
    "directory": "packages/sdk"
  },
  "peerDependencies": {
    "@coinbase/cdp-sdk": ">=1.55.0",
    "@x402/extensions": ">=2.25.0"
  },
  "peerDependenciesMeta": {
    "@coinbase/cdp-sdk": {
      "optional": true
    },
    "@x402/extensions": {
      "optional": true
    }
  }
}
