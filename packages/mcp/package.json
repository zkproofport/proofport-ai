{
  "name": "@zkproofport-ai/mcp",
  "version": "0.2.15",
  "description": "Local MCP server and CLI for ZKProofport identity proofs and experimental Arc Testnet EIP-712 action authorization. Circle Agent Wallet payments, Circle Gateway nanopayments and x402 USDC; Coinbase KYC, country and OIDC proofs.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zero-knowledge-proofs",
    "zk-proofs",
    "zkp",
    "ai-agents",
    "privacy",
    "identity",
    "coinbase-kyc",
    "google-oidc",
    "x402",
    "erc-8004",
    "noir-lang",
    "base-chain",
    "tee",
    "nitro-enclaves",
    "arc-testnet",
    "experimental-arc",
    "circle-agent-wallet",
    "circle-gateway",
    "gateway-nanopayments",
    "action-authorization",
    "eip-712"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "zkproofport-mcp": "dist/index.js",
    "zkproofport-prove": "dist/prove.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.4.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@zkproofport-ai/sdk": "^0.2.15",
    "zod": "^3.23.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkproofport/proofport-ai",
    "directory": "packages/mcp"
  }
}
