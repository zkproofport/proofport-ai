{
  "name": "proofport-ai",
  "version": "0.3.1",
  "description": "Agent-native ZK proof infrastructure for ZKProofport",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc && npm run build:approval",
    "build:approval": "npm run build --workspace @zkproofport-ai/approval-web",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "mcp:stdio": "node dist/mcp/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --project e2e",
    "test:demo:e2e": "vitest run --project e2e tests/e2e/dapp-action.test.ts",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "test:all": "vitest run",
    "typecheck:all": "tsc --noEmit -p tsconfig.scripts.json",
    "sdk:local": "npm install --no-save ../proofport-app-sdk && node -e \"console.log('Using LOCAL customer SDK (node_modules only; package.json untouched)')\"",
    "sdk:npm": "npm ci && node -e \"console.log('Restored the npm-published customer SDK from the lockfile')\"",
    "test:e2e:published": "node scripts/run-published-e2e.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.10",
    "@circle-fin/x402-batching": "^3.4.0",
    "@coinbase/agentkit": "^0.10.4",
    "@coinbase/cdp-sdk": "^1.55.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noir-lang/acvm_js": "^1.0.0-beta.8",
    "@noir-lang/noir_js": "^1.0.0-beta.8",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.212.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@opentelemetry/sdk-trace-node": "^2.5.1",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@virtuals-protocol/acp-node": "^0.3.0-beta.38",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@zkproofport-app/sdk": "0.3.3",
    "cbor-x": "^1.6.0",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.0",
    "openai": "^6.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.2.4",
    "@x402/fetch": "^2.3.0",
    "@zkproofport-ai/mcp": "^0.3.0",
    "@zkproofport-ai/sdk": "^0.3.0",
    "playwright": "1.63.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
